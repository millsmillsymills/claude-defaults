{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enableAllProjectMcpServers": false,
  "alwaysThinkingEnabled": true,
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(curl *|bash*)",
      "Bash(wget *|bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.gem/credentials)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.netrc)",
      "Edit(~/.config/anthropic/**)",
      "Edit(~/.cargo/credentials.toml)",
      "Edit(~/.config/op/**)",
      "Write(~/.bashrc)",
      "Write(~/.bash_profile)",
      "Write(~/.bash_login)",
      "Write(~/.profile)",
      "Write(~/.zshrc)",
      "Write(~/.zprofile)",
      "Write(~/.zshenv)",
      "Write(~/.ssh/**)",
      "Write(~/.gnupg/**)",
      "Write(~/.aws/**)",
      "Write(~/.azure/**)",
      "Write(~/.config/gh/**)",
      "Write(~/.git-credentials)",
      "Write(~/.docker/config.json)",
      "Write(~/.kube/**)",
      "Write(~/.npmrc)",
      "Write(~/.pypirc)",
      "Write(~/.gem/credentials)",
      "Write(~/.config/gcloud/**)",
      "Write(~/.netrc)",
      "Write(~/.config/anthropic/**)",
      "Write(~/.cargo/credentials.toml)",
      "Write(~/.config/op/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.bashrc)",
      "Read(~/.zshrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.config/op/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)"
    ],
    "allow": [
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(fd:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(which:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(pwd)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(date)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(ty:*)",
      "Bash(pytest:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(vitest:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(actionlint:*)",
      "Bash(zizmor:*)",
      "Bash(prek:*)",
      "Bash(make:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-heal.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh block-rm-rf.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh block-push-main.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh safety-block.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh warn-merge-after-pr.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh gate-public-review.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh safety-warn.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh log-tool-calls.sh pre"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh force-worktree-isolation.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh log-tool-calls.sh post"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh mark-review.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Review the assistant's final response. Reject it if the assistant is rationalizing incomplete work. Common patterns: claiming issues are 'pre-existing' or 'out of scope' to avoid fixing them, saying there are 'too many issues' to address all of them, deferring work to a 'follow-up' that was not requested, listing problems without fixing them and calling that done, or skipping test/lint failures with excuses. If the response shows any of these patterns, respond {\"ok\": false, \"reason\": \"You are rationalizing incomplete work. [specific issue]. Go back and finish.\"}. If the work is genuinely complete, respond {\"ok\": true}."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh stop-check-clean-repo.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh log-rotate.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/run-hook.sh cleanup-session-markers.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
